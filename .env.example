# ═══════════════════════════════════════════════════════════════════════════════
# PICS Surveillance Backend — Environment Configuration Template
# Copy this file to .env and configure values for your deployment environment
# ═══════════════════════════════════════════════════════════════════════════════

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/pics_surveillance

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# JWT Secret & Token Expiration
SECRET_KEY=generate_a_secure_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Celery & Redis Task Queue
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Hardware & Engine Acceleration
ENABLE_TENSORRT=true
ENABLE_GPU_DECODER=true
CUDA_VISIBLE_DEVICES=0

# AI Pipeline Thresholds
PIPELINE_CONFIDENCE_THRESHOLD=0.25
RECOGNITION_LOCK_THRESHOLD=0.44
AMBIGUOUS_THRESHOLD=0.40
AMBIGUOUS_MARGIN=0.03
MOTION_THRESHOLD_RATIO=0.005
FRAME_SAMPLE_INTERVAL=1

# Storage Paths
RAW_VIDEO_DIR=data/raw
PROCESSED_VIDEO_DIR=data/processed
CROPS_DIR=data/crops
LOG_DIR=logs
